{
  "name": "animelist",
  "version": "0.13.1",
  "description": "Suivi d'animes local-first, sans compte",
  "main": "./out/main/index.js",
  "private": true,
  "author": "Zaidal",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "release": "npm run dist && node scripts/publish-release.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "nothing": "npm run build && node scripts/nothing.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/cormorant": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode-generator": "^2.0.4"
  }
}
